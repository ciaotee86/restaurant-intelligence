# Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/apikey)
# Nếu không cung cấp, hệ thống sẽ tự động dùng chế độ Local BI Fallback
GEMINI_API_KEY=your_gemini_api_key_here

# Cổng khởi chạy FastAPI Backend (mặc định: 8000 cho local, 10000 cho Docker/Render)
PORT=8000

# Đường dẫn Database SQLite (tùy chọn)
# DATABASE_URL=sqlite:///restaurant-review-ai/data/restaurants.db

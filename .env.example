# Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/apikey)
# Nếu không cung cấp, hệ thống sẽ tự động dùng chế độ Local BI Fallback
GEMINI_API_KEY=your_gemini_api_key_here

# SerpApi Key (Tùy chọn - Tầng 1 Hybrid cào Google Maps nhanh 50+ reviews trên Web Production/Render)
# SERPAPI_KEY=your_serpapi_key_here

# Đường dẫn / Base64 phiên đăng nhập Google Maps (Tùy chọn - Tầng 2 Hybrid)
# GOOGLE_MAPS_STORAGE_STATE=restaurant-review-ai/data/google_maps_auth.json
# GOOGLE_MAPS_STORAGE_STATE_B64=

# Cổng khởi chạy FastAPI Backend (mặc định: 8000 cho local, 10000 cho Docker/Render)
PORT=8000

# Đường dẫn Database SQLite (tùy chọn)
# DATABASE_URL=sqlite:///restaurant-review-ai/data/restaurants.db
